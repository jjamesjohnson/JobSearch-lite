# JobSearch-Agent environment variables
# Copy this file to ".env" and fill in real values. The file ".env" is gitignored.

# ----- API server -----
# Shared secret required on the X-API-Key header for protected endpoints.
API_KEY=change-me-please

# CORS origin for the FastAPI server. Use a specific origin in production.
ALLOWED_ORIGIN=*

# Optional: uvicorn log level (DEBUG, INFO, WARNING, ERROR).
LOG_LEVEL=INFO

# ----- LLM provider credentials -----
# The agents run on whichever provider key is set: ANTHROPIC_API_KEY routes to
# Claude (via LiteLLM), GOOGLE_API_KEY routes to Gemini. With BOTH keys set,
# the model selectors in config/*.yaml decide per agent.
# Anthropic Claude (LiteLLM: anthropic/claude-* in config/*.yaml)
ANTHROPIC_API_KEY=

# Google Gemini (used by google-adk / langchain-google-genai)
GOOGLE_API_KEY=

# OpenAI GPT-4o / GPT-4.1 (langchain-openai)
GPT_4O_API=
GPT_4_1_API=

# DeepSeek (used by jobsearch_agent/utils/cv_match_pipeline.py)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro

# Tavily search (used by the search agents when they run on Claude; the
# Gemini path uses ADK's google_search grounding instead)
TAVILY_API_KEY=

# ----- LinkedIn scraping -----
# Required for jobsearch_agent.scraper.search.linkedin_scraper
LINKEDIN_USERNAME=
LINKEDIN_PASSWORD=

# ----- Playwright -----
# Optional: override where Playwright stores browser binaries (Docker uses /ms-playwright)
PLAYWRIGHT_BROWSERS_PATH=
